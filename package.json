{
  "name": "croppa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Privacy-focused visual Chinese-to-English translation browser extension",
  "scripts": {
    "dev": "vite",
    "prepare:assets": "node scripts/copy-runtime-assets.mjs",
    "build": "npm run prepare:assets && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:page": "node scripts/serve-test-page.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/chrome": "0.1.1",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0",
    "vite": "7.1.5",
    "vitest": "3.2.4"
  }
}
